{
  "name": "chat-application",
  "version": "1.0.0",
  "description": "Real-time chat application built with Node.js, Express, MongoDB, Mongoose and Socket.IO",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 --test-reporter=spec tests/*.test.js",
    "screenshots": "node scripts/screenshots.js"
  },
  "keywords": [
    "chat",
    "socket.io",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "real-time"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "multer": "^2.5.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "playwright-core": "^1.65.0",
    "socket.io-client": "^4.8.4"
  },
  "directories": {
    "test": "tests"
  },
  "author": ""
