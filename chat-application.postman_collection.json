{
  "info": {
    "name": "Pulse Chat API",
    "description": "Run the folders top to bottom (or use the Collection Runner). Start the server first: npm run dev",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "token2",
      "value": ""
    },
    {
      "key": "userId2",
      "value": ""
    },
    {
      "key": "conversationId",
      "value": ""
    },
    {
      "key": "groupId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) pm.collectionVariables.set('runId', Date.now().toString(36));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register user A",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice_{{runId}}\",\n  \"email\": \"alice_{{runId}}@example.com\",\n  \"password\": \"Passw0rd!x\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('no password in response', () => pm.expect(pm.response.text()).to.not.include('Passw0rd'));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.token);",
                  "pm.collectionVariables.set('userId', j.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register user B",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "noauth"
